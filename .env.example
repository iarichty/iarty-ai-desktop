# IARTY AI Desktop — environment template.
#
# Copy to `.env` and fill in your deployment's URLs. Variables are read by the
# Electron main process at build time (electron-vite inlines `MAIN_VITE_*`).
#
# These point at your IARTY deployment. The published source ships no
# production URLs — you bring your own.

# Account / auth backend (login handoff, token exchange, permissions).
MAIN_VITE_ACCOUNT_API_URL=http://localhost:4000/api

# AI feature backend (chat, models, credits).
MAIN_VITE_AI_API_URL=http://localhost:4001/api

# Public web app opened in the browser for sign-in.
MAIN_VITE_WEB_APP_URL=http://localhost:5173
