{
    "name": "iarty-ai-desktop",
    "version": "0.1.0",
    "description": "IARTY AI Desktop — cloud features + local LLM (Ollama / OpenAI-compatible).",
    "author": {
        "name": "IARTY",
        "email": "iarichty@gmail.com"
    },
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "main": "out/main/index.js",
    "homepage": "https://github.com/iarichty/iarty-ai-desktop",
    "repository": {
        "type": "git",
        "url": "https://github.com/iarichty/iarty-ai-desktop.git"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "start": "electron-vite preview",
        "build": "electron-vite build",
        "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
        "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "dist": "electron-vite build && electron-builder --config electron-builder.config.mjs",
        "dist:win": "electron-vite build && electron-builder --config electron-builder.config.mjs --win",
        "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.mjs --mac",
        "dist:linux": "electron-vite build && electron-builder --config electron-builder.config.mjs --linux",
        "release": "electron-vite build && electron-builder --config electron-builder.config.mjs --publish always"
    },
    "dependencies": {
        "electron-store": "^8.2.0",
        "framer-motion": "^12.43.0",
        "jszip": "^3.10.2",
        "jwt-decode": "^4.0.0",
        "react-icons": "^5.7.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.10.2",
        "@types/react": "^18.3.17",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "electron": "^33.3.1",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "eslint": "^9.39.5",
        "globals": "^17.12.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^5.4.11"
    }
}
